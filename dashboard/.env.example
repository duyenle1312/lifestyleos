# Local (Supabase → Connect → Direct connection; swap the user `postgres` for `dashboard_reader`).
# The direct host is IPv6-only: fine on a laptop with IPv6, not reachable from Vercel.
DASHBOARD_DATABASE_URL=postgresql://dashboard_reader:<password>@db.<project-ref>.supabase.co:5432/postgres

# Vercel (IPv4 only) — use the pooler instead (Connect → Transaction pooler, port 6543);
# there the user is `dashboard_reader.<project-ref>` and the host is the one Supabase shows:
# DASHBOARD_DATABASE_URL=postgresql://dashboard_reader.<project-ref>:<password>@<pooler-host>:6543/postgres

# Connections always use TLS (the code passes ssl: "require"); no ?sslmode needed.
# Use a URL-safe password (openssl rand -hex 24).
